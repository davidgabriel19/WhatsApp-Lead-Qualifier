# =============================================================================
# WhatsApp Lead Qualifier API — environment variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# =============================================================================

# --- API authentication -----------------------------------------------------
# Shared secret that clients (e.g. the n8n workflow) must send in the
# request body to access POST /chat. Pick a long random string.
API_KEY=replace-with-a-long-random-string

# --- AI provider ------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS_CHAT=1000
OPENAI_MAX_TOKENS_SUMMARY=500
OPENAI_TIMEOUT_SECONDS=30

# --- Session management -----------------------------------------------------
# Minutes of inactivity after which a conversation is evicted from memory.
SESSION_TTL_MINUTES=90
SESSION_MAX_SIZE=10000

# --- Domain data ------------------------------------------------------------
# Path (relative to the api/ working directory) to your catalog JSON file.
# The repo ships with a fictional sample under data/catalog.sample.json.
CATALOG_PATH=data/catalog.sample.json

# --- Prompts ----------------------------------------------------------------
SYSTEM_PROMPT_PATH=prompts/system_prompt.md
SUMMARY_PROMPT_PATH=prompts/summary_prompt.md

# --- Conversation markers ---------------------------------------------------
QUALIFIED_LEAD_TAG=#qualified_lead
RESET_COMMAND=#reset

# =============================================================================
# Handoff strategy
# =============================================================================
# How to deliver the summary of a qualified lead to a human agent:
#   none    — disabled, the API just returns the reply
#   webhook — POST the summary to an HTTP endpoint (e.g. an n8n flow)
#   twilio  — send the summary directly via Twilio WhatsApp API
HANDOFF_STRATEGY=none

# --- Handoff: webhook strategy ----------------------------------------------
# Used only when HANDOFF_STRATEGY=webhook
LEAD_HANDOFF_WEBHOOK_URL=
LEAD_HANDOFF_WEBHOOK_SECRET=
AGENT_PHONE_NUMBER=

# --- Handoff: twilio strategy -----------------------------------------------
# Used only when HANDOFF_STRATEGY=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be prefixed with "whatsapp:" — e.g. whatsapp:+14155238886
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
