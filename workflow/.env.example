# =============================================================================
# n8n workflow — environment variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# =============================================================================

# --- Postgres (local dev stack only) ----------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- n8n authentication -----------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- n8n public URL ---------------------------------------------------------
# For local development these defaults are fine. When deploying behind a
# reverse proxy (ngrok, cloudflared, Railway, Render, ...), set N8N_HOST
# and WEBHOOK_URL to your public hostname so webhook callbacks resolve.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# --- Workflow variables consumed by whatsapp-lead-qualifier.json ------------
# Point at the companion API service (see ../api/).
QUALIFIER_API_URL=http://host.docker.internal:8000
QUALIFIER_API_KEY=replace-with-the-api-key

# --- Twilio WhatsApp --------------------------------------------------------
# Only needed if the workflow sends outbound WhatsApp messages.
# The Twilio Auth Token is configured as an n8n credential in the UI
# (Credentials → HTTP Basic Auth) and is NOT read from this file.
TWILIO_ACCOUNT_SID=
# E.164 with "whatsapp:" prefix, e.g. whatsapp:+14155238886
WHATSAPP_FROM_NUMBER=
